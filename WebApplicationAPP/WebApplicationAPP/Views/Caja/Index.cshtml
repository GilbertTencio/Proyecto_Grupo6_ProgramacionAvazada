@model IEnumerable<WebApplicationAPP.Models.Caja>

@{
    ViewData["Title"] = "Cajas";
}

<h2>Cajas asignadas</h2>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Telefono</th>
            <th>Estado</th>
            <th>Fecha de registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Telefono</td>
                <td>@(item.Estado ? "Activa" : "Inactiva")</td>
                <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="VerSinpes" asp-route-idCaja="@item.IdCaja" class="btn btn-primary btn-sm">
                        Ver SINPE
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
