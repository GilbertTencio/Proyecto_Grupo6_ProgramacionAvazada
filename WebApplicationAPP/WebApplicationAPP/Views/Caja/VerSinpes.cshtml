@model IEnumerable<WebApplicationAPP.Models.Sinpe>

@{
    ViewData["Title"] = "Ver Sinpes";
}

<h2>Ver Sinpes</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Caja</th>
            <th>Telefono Origen</th>
            <th>Monto</th>
            <th>Descripcion</th>
            <th>Fecha</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Caja.NombreMostrado</td>
                <td>@item.TelefonoOrigen</td>
                <td>@item.Monto</td>
                <td>@item.Descripcion</td>
                <td>@item.FechaDeRegistro</td>
                <td>
                    @(item.Estado ? "Sincronizado" : "No sincronizado")
                </td>
            </tr>
        }
    </tbody>
</table>
