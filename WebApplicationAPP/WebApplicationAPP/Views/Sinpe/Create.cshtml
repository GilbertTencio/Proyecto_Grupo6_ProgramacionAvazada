@model WebApplicationAPP.Models.Sinpe

@{
    ViewData["Title"] = "Registrar SINPE";
}

<h2>Registrar Pago SINPE</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Teléfono Origen</label>
        <input asp-for="TelefonoOrigen" class="form-control" />
    </div>

    <div class="form-group">
        <label>Monto</label>
        <input asp-for="Monto" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <div class="form-group">
        <label>Teléfono Destino (SINPE)</label>
        <input type="text" id="TelefonoDestino" name="TelefonoDestino" class="form-control" placeholder="Ingrese número SINPE" />
    </div>

    <div class="form-group">
        <label>Comercio</label>
        <input type="text" id="NombreComercio" class="form-control" readonly />
    </div>

    <input type="hidden" id="IdCaja" name="IdCaja" /> 

    <br />

    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a> 
</form>

@section Scripts { 
    <script>
        document.getElementById("TelefonoDestino").addEventListener("blur", function () {
            var telefono = this.value;

            if (!telefono) return;

            fetch(`/Sinpe/ObtenerCajaPorTelefono?telefono=${telefono}`)
                .then(res => {
                    if (!res.ok) throw new Error(); // Si la respuesta no es 200, lanza un error para manejarlo en el catch
                    return res.json();
                })
                .then(data => {
                    document.getElementById("IdCaja").value = data.idCaja; // Asigna el IdCaja al campo oculto
                    document.getElementById("NombreComercio").value = data.nombre;
                })
                .catch(() => {
                    document.getElementById("NombreComercio").value = "No encontrado"; // Muestra un mensaje de error en el campo de comercio
                    document.getElementById("IdCaja").value = "";
                });
        });
    </script>
}