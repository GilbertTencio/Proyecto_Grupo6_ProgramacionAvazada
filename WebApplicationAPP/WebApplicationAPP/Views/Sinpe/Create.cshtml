@model WebApplicationAPP.Models.Sinpe

@{
    ViewData["Title"] = "Registrar SINPE";
}

<h2>Registrar Pago SINPE</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Create" method="post">
    
    <div class="form-group">
        <label>Teléfono Origen</label>
        <input asp-for="TelefonoOrigen" class="form-control" />
    </div>

    <div class="form-group">
        <label>Monto</label>
        <input asp-for="Monto" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <div class="form-group">
        <label>Caja</label>
        <select asp-for="IdCaja" class="form-control" asp-items="ViewBag.Cajas">
            <option value="">Seleccione una caja</option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>