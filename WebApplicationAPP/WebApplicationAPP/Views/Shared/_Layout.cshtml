<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Comercios</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bank2"></i> Banco Los Patitos
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Comercio" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                Comercios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Sinpe" asp-action="Create">
                                <i class="bi bi-arrow-left-right"></i>
                                Sinpe
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Bitacora" asp-action="Index">
                                <i class="bi bi-journal-text"></i>
                                Bitácora
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Usuario" asp-action="Index">
                                <i class="bi bi-people"></i>
                                Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="ReporteMensual" asp-action="Index">
                                <i class="bi bi-people"></i>
                                Reportes
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white">
                                    <i class="bi bi-person-circle"></i>
                                    @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                       asp-controller="Account"
                                       asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                       asp-controller="Account"
                                       asp-action="Register">
                                    <i class="bi bi-person-plus"></i>
                                    Registro
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="container">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="container">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="container">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- ✅ WIDGET -->
    <div id="weather-widget" class="weather-card">
        <div class="weather-label">Clima</div>
        <div id="weather-content">Cargando...</div>
    </div>

    <!-- ✅ CONTENIDO PRINCIPAL (TE FALTABA) -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ FOOTER -->
    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            Banco Los patitos - Grupo 6 - 2026
        </div>
    </footer>

    <!-- ✅ SCRIPTS (ORDEN CORRECTO) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <!-- ✅ SCRIPT DEL WIDGET (AHORA SÍ FUNCIONA) -->
    <script>
            $(function () {

                setTimeout(() => {
                    $("#weather-widget").addClass("show");
                }, 200);

                $.get("/api/weather")
                    .done(function (data) {

                        let icon = "☀️";
                        let label = "Soleado";

                        if (data.desc.includes("rain")) {
                            icon = "🌧️";
                            label = "Lluvioso";
                        }
                        else if (data.desc.includes("cloud")) {
                            icon = "☁️";
                            label = "Nublado";
                        }

                        const content = `
                            <strong>${icon} ${data.temp}°C</strong><br/>
                            <span style="font-size:11px">${data.city}</span><br/>
                            <span style="font-size:11px; opacity:0.7">${label}</span>
                        `;

                        $("#weather-content").fadeOut(150, function () {
                            $(this).html(content).fadeIn(200);
                        });

                    })
                    .fail(function () {
                        $("#weather-content").text("No disponible");
                    });

            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
