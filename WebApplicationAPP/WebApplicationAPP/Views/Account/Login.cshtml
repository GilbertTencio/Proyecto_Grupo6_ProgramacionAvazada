@model WebApplicationAPP.ViewModels.LoginViewModel

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="mb-3">Login</h1>

        <div class="alert alert-info">
            <div><strong>Usuario de prueba:</strong> admin@ufidelitas.ac.cr</div>
            <div><strong>Password:</strong> ContrasenaSegura1234.</div>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label">Correo</label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
