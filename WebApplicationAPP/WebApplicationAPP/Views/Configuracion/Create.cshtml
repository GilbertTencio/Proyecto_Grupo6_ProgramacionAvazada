@{
    ViewData["Title"] = "Crear Configuración";
    var comercios = ViewBag.Comercios;
}

<h2>Crear Configuración</h2>

<form method="post">

    <div class="form-group">
        <label>Comercio</label>
        <select name="IdComercio" class="form-control">
            @foreach (var c in comercios)
            {
                <option value="@c.IdComercio">@c.Nombre</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Tipo Configuración</label>
        <select name="TipoConfiguracion" class="form-control">
            <option value="1">Plataforma</option>
            <option value="2">Externa</option>
            <option value="3">Ambas</option>
        </select>
    </div>

    <div class="form-group">
        <label>Comisión (%)</label>
        <input type="number" name="Comision" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Guardar</button>

</form>