@model IEnumerable<WebApplicationAPP.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h2>Lista de Usuarios</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Usuario</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombres</th>
            <th>Primer apellido</th>
            <th>Segundo apellido</th>
            <th>Identificacion</th>
            <th>Correo electronico</th>
            <th>Fecha de registro</th>
            <th>Fecha de modificacion</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombres</td>
                <td>@item.PrimerApellido</td>
                <td>@item.SegundoApellido</td>
                <td>@item.Identificacion</td>
                <td>@item.CorreoElectronico</td>
                <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.FechaDeModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                <td>@(item.Estado ? "Activo" : "Inactivo")</td>
                <td class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-warning btn-sm">
                        Editar
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.IdUsuario" method="post" onsubmit="return confirm('¿Deseas eliminar este usuario?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
